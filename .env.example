OUTLOOK_CLIENT_ID=your-app-client-id
# Use consumers if your app registration supports Microsoft personal accounts only.
# Use common for mixed personal/work-school support, or your tenant ID for one organization.
OUTLOOK_TENANT_ID=consumers

# Google Sheets export.
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_RANGE=A:E
